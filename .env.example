# Copy this file to .env and fill in only what you use.
# Keys are read from the environment; never commit a real .env.
# Every value below is a placeholder.

# --- Model providers (at least one enabled provider is required) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_ZEN_API_KEY=

# --- Tools ---
# NASA APOD: https://api.nasa.gov
NASA_API_KEY=
# Gmail send. GMAIL_APP_PASSWORD is a Google App Password, not the account
# password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=